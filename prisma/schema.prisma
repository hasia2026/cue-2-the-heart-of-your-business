// CUE — data architecture
// Domains: Identity, Organization, Business Data, Knowledge, Intelligence,
// Decisions, Execution, Audit. SQLite for local dev; portable to Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────── IDENTITY ─────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  passwordChangedAt DateTime? // invalidates reset tokens issued before it
  memberships  Member[]
  auditEvents  AuditEvent[]
  decidedRecs  Recommendation[] @relation("RecDecider")
}

// ───────────────────────── ORGANIZATION ─────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  isDemo    Boolean  @default(false)
  ingestKey String?  @unique @default(cuid()) // bearer key for /api/ingest/* endpoints
  createdAt DateTime @default(now())

  members         Member[]
  business        BusinessProfile?
  customers       Customer[]
  employees       Employee[]
  departments     Department[]
  documents       Document[]
  knowledge       KnowledgeItem[]
  entities        Entity[]
  facts           Fact[]
  insights        Insight[]
  recs            Recommendation[]
  tasks           Task[]
  workflows       Workflow[]
  projects        Project[]
  ideas           Idea[]
  trainings       TrainingModule[]
  integrations    Integration[]
  aiSettings      AiSettings?
  auditEvents     AuditEvent[]
  brandAssets     BrandAsset[]
  jobs            Job[]
  estimates       Estimate[]
  invoices        Invoice[]
  payments        Payment[]
  communications  Communication[]
  vehicles        Vehicle[]
  deals           Deal[]
  serviceOrders   ServiceOrder[]
  leads           Lead[]
  acknowledgments PolicyAcknowledgment[]
  messageThreads  MessageThread[]
  marketWatches   MarketWatch[]
  marketSignals   MarketSignal[]
  gbpReviews      GbpReview[]
}

// ───────────────────────── MARKET SIGNALS (inbound market monitoring) ─────────────────────────

// A saved keyword watch: what to listen for and where.
model MarketWatch {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keywords       String // comma-separated phrases, matched case-insensitively
  geography      String? // e.g. "Riverside, CA"
  sourceHint     String? // where this watch is pointed: Reddit, Brand24, nextdoor…
  active         Boolean   @default(true)
  lastSignalAt   DateTime?
  createdAt      DateTime  @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  signals      MarketSignal[]

  @@index([organizationId])
}

// One inbound market mention. Created by /api/ingest/signals (social
// listening webhooks/RSS) or /api/ingest/google (GBP reviews & messages).
// Deduped by content fingerprint so replayed alerts never double-count.
model MarketSignal {
  id                 String   @id @default(cuid())
  organizationId     String
  watchId            String?
  source             String   @default("WEBHOOK") // WEBHOOK | RSS | GBP_REVIEW | GBP_MESSAGE
  externalId         String? // upstream id when the provider supplies one
  externalUrl        String?
  author             String?
  title              String
  content            String
  intent             String   @default("OTHER") // BUY | SELL | SERVICE | OTHER
  matchedKeywords    String?
  fingerprint        String
  receivedAt         DateTime @default(now())
  status             String   @default("NEW") // NEW | REVIEWED | CONVERTED_LEAD | CONVERTED_INSIGHT | DISMISSED
  convertedLeadId    String?
  convertedInsightId String?
  gbpReviewId        String?

  organization Organization @relation(fields: [organizationId], references: [id])
  watch        MarketWatch? @relation(fields: [watchId], references: [id])
  gbpReview    GbpReview?   @relation(fields: [gbpReviewId], references: [id])

  @@unique([organizationId, fingerprint])
  @@index([organizationId, status])
}

// Structured Google Business Profile review or message, with response tracking.
model GbpReview {
  id             String    @id @default(cuid())
  organizationId String
  externalId     String?
  channel        String    @default("REVIEW") // REVIEW | MESSAGE
  authorName     String
  rating         Int? // 1-5; null for messages
  sentiment      String    @default("NEUTRAL") // POSITIVE | NEUTRAL | NEGATIVE
  body           String
  reviewerUrl    String?
  postedAt       DateTime  @default(now())
  status         String    @default("NEW") // NEW | READ | REPLIED
  responseText   String?
  respondedAt    DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id])
  signals      MarketSignal[]

  @@unique([organizationId, externalId])
  @@index([organizationId])
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String // OWNER | ADMIN | MANAGER | MEMBER
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────── BUSINESS PROFILE (Company Compass) ─────────────────────────

model BusinessProfile {
  id                    String  @id @default(cuid())
  organizationId        String  @unique
  name                  String
  industry              String?
  size                  String? // e.g. "2-10"
  locations             String?
  businessModel         String?
  offerings             String? // services / products (newline separated)
  targetCustomers       String?
  mission               String?
  values                String?
  operationalPriorities String?
  onboardingStep        Int     @default(10)

  organization Organization @relation(fields: [organizationId], references: [id])
  goals        Goal[]
}

model Goal {
  id        String  @id @default(cuid())
  profileId String
  title     String
  detail    String?
  horizon   String? // QUARTER | YEAR | LONG
  status    String  @default("ACTIVE")

  profile BusinessProfile @relation(fields: [profileId], references: [id])
}

// ───────────────────────── BUSINESS DATA ─────────────────────────

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?
  type           String   @default("RESIDENTIAL") // RESIDENTIAL | COMMERCIAL
  servicePlan    String? // e.g. "Annual Comfort Club"
  status         String   @default("ACTIVE")
  notes          String?
  createdAt      DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id])
  jobs           Job[]
  estimates      Estimate[]
  invoices       Invoice[]
  payments       Payment[]
  communications Communication[]
  tasks          Task[]
  deals          Deal[]
  serviceOrders  ServiceOrder[]
  leads          Lead[]

  @@index([organizationId])
}

model Employee {
  id               String    @id @default(cuid())
  organizationId   String
  name             String
  title            String
  departmentId     String?
  managerId        String?
  email            String?
  skills           String? // comma separated
  responsibilities String?
  status           String    @default("ACTIVE")
  hireDate         DateTime?

  organization         Organization           @relation(fields: [organizationId], references: [id])
  department           Department?            @relation(fields: [departmentId], references: [id])
  manager              Employee?              @relation("EmpManager", fields: [managerId], references: [id])
  reports              Employee[]             @relation("EmpManager")
  tasks                Task[]
  assignments          TrainingAssignment[]
  jobs                 Job[]
  leads                Lead[]
  acknowledgments      PolicyAcknowledgment[]
  lessonProgress       LessonProgress[]
  threadParticipations ThreadParticipant[]

  @@index([organizationId])
}

model Department {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  description    String?

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]

  @@index([organizationId])
}

model Job {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  employeeId     String?
  title          String
  trade          String // HVAC | PLUMBING | ELECTRICAL
  status         String    @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  scheduledFor   DateTime?
  completedAt    DateTime?
  amount         Float     @default(0)
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id])
  invoices     Invoice[]

  @@index([organizationId])
}

model Estimate {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  title          String
  amount         Float
  status         String    @default("SENT") // DRAFT | SENT | VIEWED | ACCEPTED | DECLINED | EXPIRED
  sentAt         DateTime?
  lastFollowUpAt DateTime?
  expiresAt      DateTime?
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])

  @@index([organizationId])
}

model Invoice {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  jobId          String?
  number         String
  amount         Float
  status         String    @default("SENT") // DRAFT | SENT | PAID | OVERDUE | VOID
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  job          Job?         @relation(fields: [jobId], references: [id])

  @@index([organizationId])
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  invoiceId      String?
  amount         Float
  method         String
  receivedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])

  @@index([organizationId])
}

model Communication {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  channel        String // EMAIL | PHONE | SMS | IN_PERSON
  direction      String   @default("OUTBOUND")
  summary        String
  occurredAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])

  @@index([organizationId])
}

// ───────────────────────── INDUSTRY PACK: AUTO DEALERSHIP ─────────────────────────

model Vehicle {
  id             String    @id @default(cuid())
  organizationId String
  stockNumber    String
  vin            String?
  year           Int
  make           String
  model          String
  trim           String?
  kind           String    @default("USED") // NEW | USED
  status         String    @default("AVAILABLE") // IN_TRANSIT | AVAILABLE | RESERVED | SOLD
  listPrice      Float?
  cost           Float?
  listedAt       DateTime?
  soldAt         DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id])
  deals         Deal[]
  serviceOrders ServiceOrder[]

  @@index([organizationId])
}

model Deal {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  vehicleId      String?
  dealType       String    @default("USED") // NEW | USED
  status         String    @default("NEGOTIATING") // NEGOTIATING | PENDING_FINANCE | WON | LOST
  amount         Float
  financeSentAt  DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])

  @@index([organizationId])
}

model ServiceOrder {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  vehicleId      String?
  title          String
  status         String    @default("OPEN") // OPEN | IN_PROGRESS | AWAITING_PARTS | COMPLETED
  amount         Float     @default(0)
  openedAt       DateTime  @default(now())
  completedAt    DateTime?
  invoicedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])

  @@index([organizationId])
}
model Lead {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  source         String    @default("WEB") // WEB | PHONE | WALK_IN | REFERRAL | MARKET | GBP | CSV
  interest       String?
  estValue       Float?
  status         String    @default("NEW") // NEW | CONTACTED | QUALIFIED | WON | LOST
  assignedToId   String?
  customerId     String? // linked when first contact is logged (lead → customer)
  createdAt      DateTime  @default(now())
  lastContactAt  DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  assignedTo   Employee?    @relation(fields: [assignedToId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])

  @@index([organizationId])
}

// ───────────────────────── KNOWLEDGE ─────────────────────────

model Document {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  fileName       String
  mimeType       String
  sizeBytes      Int      @default(0)
  kind           String   @default("OTHER") // POLICY | PROCEDURE | CONTRACT | RECORD | NOTE | SPREADSHEET | MEDIA | OTHER
  departmentId   String?
  status         String   @default("PROCESSED") // UPLOADED | PROCESSING | PROCESSED | FAILED
  extractedText  String?
  uploadedAt     DateTime @default(now())
  source         String   @default("UPLOAD") // UPLOAD | IMPORT | SEED

  organization    Organization           @relation(fields: [organizationId], references: [id])
  knowledge       KnowledgeItem[]
  acknowledgments PolicyAcknowledgment[]

  @@index([organizationId])
}

model KnowledgeItem {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String?
  title          String
  content        String
  category       String // POLICY | PROCEDURE | DECISION | LESSON | CUSTOMER | PRODUCT | HISTORY | STRATEGY
  tags           String? // comma separated
  status         String   @default("FACT") // FACT | ASSUMPTION | RECOMMENDATION | DECISION
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  document     Document?    @relation(fields: [documentId], references: [id])

  @@index([organizationId])
}

model Entity {
  id             String  @id @default(cuid())
  organizationId String
  type           String // CUSTOMER | EMPLOYEE | PRODUCT | DEPARTMENT | POLICY | PROCESS | RISK | OPPORTUNITY
  name           String
  description    String?

  organization Organization @relation(fields: [organizationId], references: [id])
  facts        Fact[]

  @@index([organizationId])
}

model Fact {
  id             String   @id @default(cuid())
  organizationId String
  entityId       String
  statement      String
  documentId     String?
  confidence     Float    @default(0.9)
  status         String   @default("FACT") // FACT | ASSUMPTION
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  entity       Entity       @relation(fields: [entityId], references: [id])

  @@index([organizationId])
}

// ───────────────────────── INTELLIGENCE ─────────────────────────

model Insight {
  id             String   @id @default(cuid())
  organizationId String
  type           String // RISK | OPPORTUNITY | REVENUE | OPERATIONS | CUSTOMER | ANOMALY
  title          String
  summary        String
  severity       String   @default("MEDIUM") // HIGH | MEDIUM | LOW
  impactValue    Float? // e.g. dollars at stake
  evidence       String // JSON array of evidence refs
  reasoning      String
  confidence     Float    @default(0.8)
  status         String   @default("OPEN") // OPEN | ACTION_TAKEN | DISMISSED | RESOLVED
  createdAt      DateTime @default(now())
  recId          String?

  organization    Organization     @relation(fields: [organizationId], references: [id])
  recommendations Recommendation[] @relation("InsightRec")

  @@index([organizationId])
}

model Recommendation {
  id             String    @id @default(cuid())
  organizationId String
  insightId      String?
  title          String
  action         String
  rationale      String
  impact         String?
  impactValue    Float?
  confidence     Float     @default(0.8)
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | MODIFIED | DEFERRED | EXECUTED
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?
  decidedById    String?
  workflowId     String?

  organization Organization @relation(fields: [organizationId], references: [id])
  insight      Insight?     @relation("InsightRec", fields: [insightId], references: [id])
  decidedBy    User?        @relation("RecDecider", fields: [decidedById], references: [id])
  // organization relation declared on Organization.recs
  workflow     Workflow?    @relation

  @@index([organizationId])
}

// ───────────────────────── EXECUTION ─────────────────────────

model Workflow {
  id             String   @id @default(cuid())
  organizationId String
  recId          String?  @unique
  title          String
  description    String?
  kind           String   @default("FOLLOW_UP") // FOLLOW_UP | BILLING | PROCESS | TRAINING | CUSTOM
  status         String   @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  source         String   @default("AI_RECOMMENDATION") // AI_RECOMMENDATION | MANUAL
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id])
  rec          Recommendation? @relation(fields: [recId], references: [id])
  tasks        Task[]

  @@index([organizationId])
}

model Project {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         String    @default("ACTIVE")
  dueAt          DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  tasks        Task[]

  @@index([organizationId])
}

model Task {
  id             String    @id @default(cuid())
  organizationId String
  workflowId     String?
  projectId      String?
  title          String
  detail         String?
  status         String    @default("OPEN") // OPEN | IN_PROGRESS | DONE | CANCELLED
  priority       String    @default("MEDIUM") // HIGH | MEDIUM | LOW
  dueAt          DateTime?
  assigneeId     String? // Employee
  customerId     String?
  origin         String    @default("MANUAL") // AI_RECOMMENDATION | MANUAL | WORKFLOW
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  workflow     Workflow?    @relation(fields: [workflowId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  assignee     Employee?    @relation(fields: [assigneeId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])

  @@index([organizationId])
}

// ───────────────────────── EXPAND / ENHANCE / LAB ─────────────────────────

model TrainingModule {
  id             String  @id @default(cuid())
  organizationId String
  title          String
  summary        String
  category       String // ONBOARDING | SAFETY | PRODUCT | PROCESS | CUSTOMER
  source         String  @default("AI_GENERATED") // AI_GENERATED | MANUAL
  knowledgeRefs  String? // JSON array of knowledgeItem ids
  content        String

  organization Organization         @relation(fields: [organizationId], references: [id])
  assignments  TrainingAssignment[]
  lessons      TrainingLesson[]

  @@index([organizationId])
}

model TrainingAssignment {
  id         String @id @default(cuid())
  trainingId String
  employeeId String
  status     String @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | COMPLETED

  training TrainingModule @relation(fields: [trainingId], references: [id])
  employee Employee       @relation(fields: [employeeId], references: [id])

  @@unique([trainingId, employeeId])
}

// Training: ordered lessons inside a module (video or text), plus quizzes.
model TrainingLesson {
  id             String  @id @default(cuid())
  organizationId String
  moduleId       String
  title          String
  sort           Int     @default(0)
  videoUrl       String? // uploaded file path or external URL (YouTube, Loom…)
  videoKind      String? // UPLOAD | YOUTUBE | LOOM | VIMEO | LINK
  durationMin    Int?
  content        String? // lesson text / transcript / talking points

  module   TrainingModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quiz     LessonQuiz?
  progress LessonProgress[]

  @@index([organizationId, moduleId])
}

model LessonQuiz {
  id         String @id @default(cuid())
  lessonId   String @unique
  passingPct Int    @default(80)
  questions  String // JSON: [{q, options[4], answerIndex}]

  lesson TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonProgress {
  id             String    @id @default(cuid())
  organizationId String
  lessonId       String
  employeeId     String
  status         String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  quizScore      Int? // 0-100, best score kept
  completedAt    DateTime?

  lesson   TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  employee Employee       @relation(fields: [employeeId], references: [id])

  @@unique([lessonId, employeeId])
  @@index([organizationId])
}

// Messaging: 1:1 and group threads scoped to the organization.
model MessageThread {
  id             String   @id @default(cuid())
  organizationId String
  title          String? // null for direct messages
  isGroup        Boolean  @default(false)
  createdAt      DateTime @default(now())
  lastMessageAt  DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id])
  participants ThreadParticipant[]
  messages     Message[]

  @@index([organizationId])
}

model ThreadParticipant {
  id         String    @id @default(cuid())
  threadId   String
  employeeId String
  lastReadAt DateTime?

  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id])

  @@unique([threadId, employeeId])
  @@index([employeeId])
}

model Message {
  id               String   @id @default(cuid())
  threadId         String
  authorEmployeeId String?
  authorName       String // snapshot (owner may message without an employee row)
  body             String
  createdAt        DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// Compliance: which employee acknowledged which policy document, when.
model PolicyAcknowledgment {
  id              String   @id @default(cuid())
  organizationId  String
  documentId      String
  employeeId      String
  acknowledgedAt  DateTime @default(now())
  signature       String // typed full name at acknowledgment time
  documentVersion String? // snapshot of doc updatedAt for audit trail

  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([documentId, employeeId])
  @@index([organizationId])
}

model Idea {
  id               String   @id @default(cuid())
  organizationId   String
  title            String
  problem          String?
  hypothesis       String?
  proposedSolution String?
  evidence         String?
  owner            String?
  status           String   @default("IDEA") // IDEA | EXPERIMENTING | VALIDATED | PARKED | LAUNCHED
  nextStep         String?
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model BrandAsset {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  kind           String // LOGO | GUIDELINE | TEMPLATE | SOCIAL | DOCUMENT
  description    String?
  status         String  @default("READY")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// ───────────────────────── ECOSYSTEM & SETTINGS ─────────────────────────

model Integration {
  id             String    @id @default(cuid())
  organizationId String
  key            String // quickbooks | servicetitan | google_calendar ...
  name           String
  category       String // ACCOUNTING | CRM | SCHEDULING | PAYMENTS | EMAIL | STORAGE | HR | ECOMMERCE
  status         String    @default("DEMO") // CONNECTED | DEMO | AVAILABLE
  dataAvailable  String? // what CUE can read
  capabilities   String? // what CUE can do
  lastSyncAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@index([organizationId])
}

model AiSettings {
  id             String  @id @default(cuid())
  organizationId String  @unique
  observe        Boolean @default(true)
  recommend      Boolean @default(true)
  prepare        Boolean @default(true)
  execute        Boolean @default(false)
  automate       Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])
}

// ───────────────────────── AUDIT ─────────────────────────

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorType      String   @default("USER") // USER | AI | SYSTEM
  actorId        String?
  action         String // e.g. RECOMMENDATION_CREATED, RECOMMENDATION_APPROVED, WORKFLOW_CREATED, TASK_COMPLETED
  targetType     String? // Recommendation | Workflow | Task | Document | Insight | AiSettings
  targetId       String?
  detail         String?
  metadata       String? // JSON
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
