# ─────────────────────────────────────────────────────────────
# CUE environment — copy to .env and fill in.
# NEVER commit the real .env. This file documents shape only.
# ─────────────────────────────────────────────────────────────

# ── SQLite (default, local dev — no Supabase needed) ──
# Relative to the prisma/ folder.
DATABASE_URL="file:./db/custom.db"

# ── Supabase Postgres (production / Vercel / pilot) ──
# 1. Supabase dashboard → your project → Connect (top bar)
# 2. Copy the "Connection string" values. Prisma needs TWO:
#
#    DATABASE_URL = the POOLED connection (pgBouncer, port 6543).
#                   Used by the running app (required on Vercel).
#                   Append &pgbouncer=true&connection_limit=5
#    DIRECT_URL   = the DIRECT connection (port 5432).
#                   Used by prisma db push for schema changes (DDL).
#                   NOTE: the bare db.<ref>.supabase.co host is IPv6-only
#                   on many networks — the session pooler below is the
#                   IPv4-friendly equivalent for DDL.
#
#    Pooled:   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
#    Session:  postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Session signing secret for CUE auth cookies (any long random hex).
# On Vercel this is REQUIRED — never run production on the dev fallback.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUE_SESSION_SECRET="<64 hex chars>"

# Legacy alias also accepted (session.ts checks CUE_ first, then BIZMO_):
# BIZMO_SESSION_SECRET="<64 hex chars>"

# Demo flag: shows demo-workspace hints in the UI.
BIZMO_DEMO_MODE="false"

# ── Supabase Storage (file uploads in production) ──
# When BOTH are set, uploads (training videos, files) go to Supabase Storage
# instead of public/uploads (which is ephemeral on Vercel). Supabase →
# Project Settings → API → copy the project URL and the service_role key
# (SERVER-ONLY secret — never expose to the browser).
# Objects go to bucket "cue-uploads" (auto-created, public read via unguessable path).
#SUPABASE_URL="https://<ref>.supabase.co"
#SUPABASE_SERVICE_ROLE_KEY="<service_role key>"
# Optional override: "local" | "supabase" (default: auto-detect from the two above)
#STORAGE_BACKEND="supabase"
