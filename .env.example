# CUE v2 — environment template. Copy to .env and fill in. Never commit .env.

# Supabase Postgres — DIRECT connection (local dev, db setup/seed, DDL)
DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase Postgres — POOLED connection (use this on Vercel; postgres.js handles pgbouncer)
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Session signing secret — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUE_SESSION_SECRET="<64 hex chars>"

# Demo mode seeding flag used by scripts (not read by app runtime)
CUE_DEMO_MODE="true"

# ── Billing / partner program (Stripe) ──────────────────────────────
# Operator plan recurring price (price_... from the Stripe dashboard)
STRIPE_PRICE_ID=
STRIPE_SECRET_KEY=
# Webhook endpoint secret (whsec_...) pointing at /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ── Booking (Calendly) ──────────────────────────────────────────────
# Your Calendly event link, e.g. https://calendly.com/<you>/cue-scan-call
CALENDLY_URL=

# ── Email (Resend) — powers password-reset emails. Free tier: 3,000/mo ──
# Create an API key at https://resend.com/api-keys (full access), or use the
# shared onboarding sender while testing: MAIL_FROM=CUE <onboarding@resend.dev>
RESEND_API_KEY=
MAIL_FROM=CUE <onboarding@resend.dev>

# ── App ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3210
