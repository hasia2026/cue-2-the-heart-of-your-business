[TEMPLATE]
# CUE v2 — environment template. Copy to .env and fill in. Never commit .env.

# Supabase Postgres — DIRECT connection (local dev, db setup/seed, DDL)
DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase Postgres — POOLED connection (use this on Vercel; postgres.js handles pgbouncer)
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Session signing secret — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUE_SESSION_SECRET="<64 hex chars>"

# Demo mode seeding flag used by scripts (not read by app runtime)
CUE_DEMO_MODE="true"

# ── Billing / partner program (Stripe) ──────────────────────────────
# Operator plan recurring price (price_... from the Stripe dashboard)
STRIPE_PRICE_ID=
STRIPE_SECRET_KEY=
# Webhook endpoint secret (whsec_...) pointing at /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ── Booking (Calendly) ──────────────────────────────────────────────
# Your Calendly event link, e.g. https://calendly.com/<you>/cue-scan-call
CALENDLY_URL=

# ── Email (Resend) — powers password-reset emails. Free tier: 3,000/mo ──
# Create an API key at https://resend.com/api-keys (full access), or use the
# shared onboarding sender while testing: MAIL_FROM=CUE <onboarding@resend.dev>
RESEND_API_KEY=
MAIL_FROM=CUE <onboarding@resend.dev>

# ── AI Ambassador — free LLM server defaults (optional) ──────────────
# Per-org keys configured in Settings always win. With none set, the first of
# these env keys is used as the org-agnostic default; with neither set the
# Ambassador answers from the grounded records engine alone (mode: grounded).
#   Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
#   Anthropic (Claude): https://console.anthropic.com/settings/keys — create the
#   key in the WORKSPACE containing your CUE project, with a monthly spend limit.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
#   xAI (Grok): https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-3-mini
#   Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
#   Also used by `npm run tour:video` for natural-voice narration of the
#   product-tour video (falls back to Windows SAPI voice when unset).
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ── WhatsApp (Meta Cloud API) — free first-party channel ─────────────
# The ONLY free, first-party WhatsApp integration. Create a Meta app at
# https://developers.facebook.com, add the WhatsApp product, grab the phone
# number id + a system-user token, then set the webhook URL to
#   https://<your-domain>/api/webhooks/whatsapp
# with the verify token below. Without these the integration honestly shows
# AVAILABLE and the webhook refuses unverified calls.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Which organization's records inbound messages are answered from
WHATSAPP_ORG_ID=

# ── App ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3210
